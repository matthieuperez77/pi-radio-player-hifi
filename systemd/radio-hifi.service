[Unit]
Description=Lecteur radio web HiFi (LCD + encodeurs)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=$USER
WorkingDirectory=/home/$USER/projects/pi-radio-player-hifi
ExecStart=/home/$USER/projects/pi-radio-player-hifi/.venv/bin/python3 -m radio.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
